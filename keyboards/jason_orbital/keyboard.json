{
  "manufacturer": "Seojoon Yeon",
  "keyboard_name": "jason_orbital",
  "maintainer": "Seojoon Yeon",

  "processor": "RP2040",
  "bootloader": "rp2040",
  "diode_direction": "ROW2COL",

  "matrix_size": {
    "rows": 4,
    "cols": 3
  },

  "usb": {
      "vid": "0x444D",
      "pid": "0x3435",
      "device_version": "0.0.1"
  },

  "features": {
    "bootmagic": true,
    "extrakey": true,
    "nkro": true
  },

  "encoder": {
    "enabled": true,
    "rotary": [
      { "pin_a": "GP28", "pin_b": "GP29", "resolution": 4 },
      { "pin_a": "GP28", "pin_b": "GP29", "resolution": 4 }
    ]
  },
  
  "split": {
    "enabled": true,
    "main": "left",
    "bootmagic": { "matrix": [0, 0] }
  },

  "layouts": {
    "LAYOUT": {
      "layout": [
        { "matrix": [0, 0], "x": 0, "y": 0 },
        { "matrix": [0, 1], "x": 1, "y": 0 },
        { "matrix": [0, 2], "x": 2, "y": 0 },
        { "matrix": [1, 0], "x": 0, "y": 1 },
        { "matrix": [1, 1], "x": 1, "y": 1 },
        { "matrix": [1, 2], "x": 2, "y": 1 },

        { "matrix": [2, 0], "x": 6, "y": 0 },
        { "matrix": [2, 1], "x": 7, "y": 0 },
        { "matrix": [2, 2], "x": 8, "y": 0 },
        { "matrix": [3, 0], "x": 6, "y": 1 },
        { "matrix": [3, 1], "x": 7, "y": 1 },
        { "matrix": [3, 2], "x": 8, "y": 1 }
      ]
    }
  }
}
